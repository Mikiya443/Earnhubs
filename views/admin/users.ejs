<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Users — Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/nav') %>
  <div class="admin-layout">
    <% var active = 'users' %>
    <%- include('../partials/admin-sidebar', { active }) %>
    <div class="admin-main">
      <%- include('../partials/flash') %>
      <h2>Users (<%= users.length %>)</h2>
      <form method="GET" style="margin-bottom:16px; max-width:320px;">
        <input type="text" name="q" placeholder="Search by name or email" value="<%= q %>" />
      </form>
      <div class="card" style="overflow-x:auto;">
        <table>
          <thead>
            <tr><th>Name</th><th>Email</th><th>Balance</th><th>Status</th><th>Joined</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.name %></td>
                <td><%= u.email %></td>
                <td>₦<%= u.balance.toFixed(2) %></td>
                <td><span class="pill pill-<%= u.status %>"><%= u.status %></span></td>
                <td><%= new Date(u.created_at).toLocaleDateString() %></td>
                <td style="min-width:260px;">
                  <form action="/admin/users/<%= u.id %>/adjust-balance" method="POST" style="display:inline-flex; gap:4px; margin-right:6px;">
                    <input type="number" name="amount" step="0.01" placeholder="+/- amt" style="width:90px; margin:0;" required />
                    <input type="hidden" name="reason" value="Admin adjustment" />
                    <button class="btn btn-secondary btn-sm" type="submit">Adjust</button>
                  </form>
                  <% if (u.status === 'banned') { %>
                    <form action="/admin/users/<%= u.id %>/unban" method="POST" style="display:inline;">
                      <button class="btn btn-sm" type="submit">Unban</button>
                    </form>
                  <% } else { %>
                    <form action="/admin/users/<%= u.id %>/ban" method="POST" style="display:inline;">
                      <button class="btn btn-danger btn-sm" type="submit">Ban</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
